{
  // Mini App: plain static site, no build step — deployed as-is.
  "static": {
    "source": "dist",
    "spa": true,
    // revalidate every load so pushed changes show up immediately
    "headers": [{ "path": "/*", "set": { "Cache-Control": "no-cache" } }],
  },
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json"
}
